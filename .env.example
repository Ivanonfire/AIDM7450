# MongoDB Atlas connection string.
# Leave blank (or omit this file) to use the local JSON fallback store.
# Example:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/nightpulse?retryWrites=true&w=majority
MONGODB_URI=

# Database name (used when the URI does not already select one)
MONGODB_DB=nightpulse

# Web server port
PORT=3000
